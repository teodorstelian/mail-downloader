# Copy this file to .env and enter your own settings.
YAHOO_EMAIL=you@yahoo.com
YAHOO_APP_PASSWORD=
BACKUP_OUTPUT=D:\MailBackup
# Positive number per folder; leave blank for all messages.
BACKUP_LIMIT=
BACKUP_START_DATE=
BACKUP_END_DATE=
# inbox = Inbox only; all = every selectable folder.
BACKUP_FOLDERS=all
IMAP_TIMEOUT=300
BACKUP_RETRIES=5
